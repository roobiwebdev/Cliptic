# ===========================================================================
# Database — REQUIRED
# ===========================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ===========================================================================
# Better Auth
# ===========================================================================
# REQUIRED in production. Generate with: openssl rand -base64 32
# (The dev fallback in auth.ts is going away — production must set this.)
BETTER_AUTH_SECRET=""
# Public origin Better Auth signs callbacks against. Must match APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================================================
# Google OAuth — OPTIONAL
# ===========================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================================================
# App branding (public)
# ===========================================================================
NEXT_PUBLIC_APP_NAME="Web Prodigies"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used in <meta name="description"> and OG cards. Optional — falls back to
# "<APP_NAME> — multi-tenant SaaS." when unset.
NEXT_PUBLIC_APP_DESCRIPTION=""
# Bare apex domain used by the auth layer for cross-subdomain cookies.
# Set this when you serve the app from multiple subdomains (e.g. app.x.com
# and admin.x.com) so cookies are scoped to ".x.com". Leave unset locally.
NEXT_PUBLIC_APP_DOMAIN=""

# ===========================================================================
# Registration mode
# ===========================================================================
# "true"  → anyone can sign up (DEFAULT when unset)
# "false" → all sign-up paths are closed at the auth-hook layer
NEXT_PUBLIC_REGISTRATION_OPEN="true"

# ===========================================================================
# Upstash Redis — OPTIONAL
# ===========================================================================
# Powers rate limiting ONLY (NOT a query cache). When unset, rate limiters
# fail open and the app still runs — fine for local dev; configure in
# production to actually enforce limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===========================================================================
# Email — Resend — OPTIONAL (transactional email)
# ===========================================================================
# Powers verification, password-reset, and team-invitation emails. When
# RESEND_API_KEY is unset, the email service no-ops (and Better Auth logs the
# verification/reset URL to the server console) so local dev works without an
# account. Configure in production to actually deliver email.
RESEND_API_KEY=""
# The "From" address. Falls back to "onboarding@resend.dev" when unset (only
# valid for Resend test sends). Use a verified domain address in production.
RESEND_FROM_EMAIL=""

# ===========================================================================
# Stripe — billing — OPTIONAL (subscriptions)
# ===========================================================================
# Server secret + client publishable key. When STRIPE_SECRET_KEY is unset the
# billing layer fails soft (checkout/upgrade calls error clearly, the rest of
# the app runs). Use test keys (sk_test_… / pk_test_…) locally.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the /api/stripe/webhook endpoint. From the Stripe
# dashboard, or `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# --- Plan → Stripe Price IDs ---------------------------------------------
# One recurring Price per (plan, interval) created in the Stripe dashboard.
# The "free" plan has no price. Map each paid plan key from src/lib/config/plans.ts.
NEXT_PUBLIC_STARTER_PRICE_MONTHLY=""
NEXT_PUBLIC_STARTER_PRICE_YEARLY=""
NEXT_PUBLIC_PRO_PRICE_MONTHLY=""
NEXT_PUBLIC_PRO_PRICE_YEARLY=""
NEXT_PUBLIC_ENTERPRISE_PRICE_MONTHLY=""
NEXT_PUBLIC_ENTERPRISE_PRICE_YEARLY=""

# --- Plan display names ---------------------------------------------------
# Rename any plan WITHOUT touching code. Blank/unset falls back to the default
# shown here. (The hidden "portal" admin tier can't be renamed.)
NEXT_PUBLIC_FREE_NAME="Free"
NEXT_PUBLIC_STARTER_NAME="Starter"
NEXT_PUBLIC_PRO_NAME="Pro"
NEXT_PUBLIC_ENTERPRISE_NAME="Enterprise"

# --- Show plan in the pricing table --------------------------------------
# "true" shows the plan in the pricing UI, "false" hides it (e.g. an Enterprise
# "contact us" tier). Hiding does NOT disable the plan — subscriptions/upgrades
# to it still work; it's only hidden from the pricing grid. Default: true.
NEXT_PUBLIC_FREE_SHOW_PLAN="true"
NEXT_PUBLIC_STARTER_SHOW_PLAN="true"
NEXT_PUBLIC_PRO_SHOW_PLAN="true"
NEXT_PUBLIC_ENTERPRISE_SHOW_PLAN="true"

# --- Free-trial length (days) --------------------------------------------
# Days of free trial when subscribing to each plan. 0 = no trial. Trial-abuse
# checks still apply. Default: free 0, starter 14, pro 14, enterprise 30.
NEXT_PUBLIC_FREE_TRIAL_DAYS="0"
NEXT_PUBLIC_STARTER_TRIAL_DAYS="14"
NEXT_PUBLIC_PRO_TRIAL_DAYS="14"
NEXT_PUBLIC_ENTERPRISE_TRIAL_DAYS="30"

# ===========================================================================
# Platform-admin portal — OPTIONAL
# ===========================================================================
# A private /portal admin area just for you, the app owner: see and manage
# every organization and user, and view activity across the whole app.
# It stays off until you set PORTAL_ENABLED to "true".
PORTAL_ENABLED="false"
# The email address you'll sign in with. When the portal is on, the first time
# this person signs in they automatically get admin access to /portal — you
# don't have to set up anything by hand. Leave blank if the portal is off.
PORTAL_INITIAL_OWNER_EMAIL=""
# Route prefix for the portal (default /portal).
PORTAL_PATH_PREFIX="/portal"

# ===========================================================================
# Cliptic media pipeline — AI providers — REQUIRED for clip processing
# ===========================================================================
# Swap the AI backend with ONE value (bring-your-own-key OR run locally/free).
LLM_PROVIDER="openai"                 # openai | anthropic | ollama
TRANSCRIBER="openai"                  # openai | whisper-cpp
# OpenAI powers the default LLM (clip selection) AND transcription (Whisper).
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_BASE_URL=""                    # optional OpenAI-compatible endpoint
OPENAI_TRANSCRIBE_MAX_UPLOAD_MB="24"  # audio over this is chunked on silence
# Anthropic (optional alternative LLM).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
# Ollama (optional local/free LLM). Requires `ollama serve`.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# whisper.cpp (optional local/free transcription).
WHISPER_CPP_BIN="whisper-cli"
WHISPER_CPP_MODEL=""

# --- Clip selection tuning (safe defaults; edit freely) -------------------
CLIP_COUNT="8"                        # target number of clips per video
CLIP_TARGET_MIN_SEC="20"
CLIP_TARGET_MAX_SEC="60"
CLIP_HARD_MIN_SEC="15"                # reject clips shorter than this
CLIP_HARD_MAX_SEC="90"                # trim clips longer than this
SECTION_PADDING_SEC="1.5"             # padding for silence-snapping boundaries

# --- Download & encode speed ----------------------------------------------
# The worker downloads the source ONCE (capped resolution) and cuts every clip
# from the local file. aria2c (in the worker Docker image) bypasses YouTube
# throttling; point YTDLP_BIN at a fresh yt-dlp if the system one lags.
YTDLP_BIN="yt-dlp"
YTDLP_DOWNLOADER="auto"               # auto | aria2c | native
YTDLP_PLAYER_CLIENT=""                # optional, e.g. "tv,ios" or "web_safari"
# --- YouTube on cloud hosts (datacenter IPs get bot-blocked / HTTP 429) --------
# Locally your home IP is trusted so links just work; on Railway/AWS/etc. YouTube
# often returns 429. Two fixes (either one usually unblocks it):
#   1) YTDLP_COOKIES — paste the FULL contents of a Netscape cookies.txt exported
#      from a browser signed in to YouTube (extension: "Get cookies.txt LOCALLY").
#      yt-dlp then downloads as that session. Simplest fix.
#   2) YTDLP_PROXY — a residential/rotating proxy URL (http://user:pass@host:port).
#      The guaranteed fix when the host IP is hard-blocked (costs money).
# Uploads never touch YouTube, so file upload always works regardless.
YTDLP_COOKIES=""                      # raw cookies.txt contents (multi-line ok)
YTDLP_PROXY=""                        # e.g. http://user:pass@proxy-host:port
CLIP_SOURCE_MAX_HEIGHT="720"          # cap source resolution
CLIP_ENCODE_PRESET="veryfast"         # libx264 preset (ultrafast = fastest)
CLIP_CUT_CONCURRENCY=""               # clips encoded at once; blank = auto min(cpus,4)
TRANSCRIBE_CONCURRENCY="4"            # concurrent Whisper requests for long audio

# ===========================================================================
# Job queue — BullMQ / Redis — REQUIRED for the worker
# ===========================================================================
# BullMQ needs a REAL TCP Redis (redis://…) — NOT the Upstash REST client above.
# Get one from Railway (add a Redis plugin) → Connect → copy the URL.
REDIS_URL=""
WORKER_CONCURRENCY="2"                # simultaneous clip jobs the worker runs

# ===========================================================================
# Object storage — Cloudflare R2 — REQUIRED for artifacts
# ===========================================================================
# S3-compatible, no egress fees. Cloudflare dashboard → R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cliptic-artifacts"
R2_ENDPOINT=""                        # https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLIP_RETENTION_DAYS="7"               # artifact TTL; set a matching R2 lifecycle rule
MAX_UPLOAD_MB="1024"                  # max direct-upload size

# ===========================================================================
# Billing — Polar (Merchant of Record) — Phase 6
# ===========================================================================
# Replaces Stripe. polar.sh (prod) / sandbox.polar.sh (test).
POLAR_ACCESS_TOKEN=""                 # Settings → Developers → New Token
POLAR_WEBHOOK_SECRET=""               # Settings → Webhooks → New Endpoint
POLAR_SERVER="sandbox"                # sandbox | production
POLAR_PRODUCT_STARTER=""              # Products → Starter → Product ID
POLAR_PRODUCT_PRO=""
POLAR_PRODUCT_ENTERPRISE=""
NEXT_PUBLIC_POLAR_SUCCESS_URL="http://localhost:3000/dashboard/settings/billing?success=1"
