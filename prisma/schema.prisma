// ============================================================================
// PRISMA SCHEMA
// ============================================================================
//
// Foundation models for the app:
//   1. Authentication (Better Auth)   — User, Session, Account, Verification, TwoFactor
//   2. Multi-tenant organizations     — Organization, Member, Invitation, OrganizationRole
//   3. Subscription billing            — Subscription
//   4. Feature-gate usage tracking     — UsageMetrics
//   5. Audit logging                   — ActivityLog
//
// Add your own domain models BELOW these with `organizationId` as the
// tenancy key.
//
// SOURCE OF TRUTH RULE: Prisma is the source of truth for any data shape
// it can describe. Never duplicate a database type into a TS interface.
// Import from `@/generated/prisma` or use `Prisma.<Type>` helpers.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Generated client lives inside src/ so imports stay typed and bundler-friendly
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// BETTER AUTH — Core authentication models
// ============================================================================
//
// These models are required by Better Auth and its plugins. The shape is
// defined by Better Auth's schema generator — do NOT rename fields without
// also updating the auth config and re-running `npx @better-auth/cli generate`.
//
// SOURCE OF TRUTH KEYWORDS: User, Session, Account, Verification, TwoFactor
// ============================================================================

/// User — the primary identity record. Links to all auth credentials,
/// organization memberships, sessions, and audit logs.
model User {
  id                 String     @id
  name               String
  email              String     @unique
  emailVerified      Boolean    @default(false)
  image              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  // Better Auth twoFactor plugin — flag indicating 2FA is enabled
  twoFactorEnabled   Boolean?   @default(false)

  // Better Auth admin plugin — 'admin' grants impersonation + admin endpoint access
  role               String?
  banExpires         DateTime?
  banReason          String?
  banned             Boolean?   @default(false)

  // Application-level fields
  onboardingComplete Boolean    @default(false)
  firstName          String?
  lastName           String?

  // Relations
  accounts         Account[]
  sessions         Session[]
  twofactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  activityLogs     ActivityLog[]
  cardFingerprints CardFingerprint[]
  clipJobs         ClipJob[]
  referralCode     ReferralCode?

  @@map("user")
}

/// Session — issued at sign-in, validated on every request.
/// `activeOrganizationId` powers the org-scoped procedure (set lazily by
/// Better Auth's organization plugin or by our session-create hook).
model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String

  // Better Auth organization plugin — current active org for this session
  activeOrganizationId String?

  // Better Auth admin plugin — impersonation chain (admin user ID)
  impersonatedBy       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

/// Account — credential record, one per provider per user (email+password,
/// google, github, etc.). The `password` field stores the hash for email auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Verification — short-lived tokens for email verification, password reset,
/// magic links, etc. Cleaned up automatically once consumed or expired.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

/// TwoFactor — TOTP secret + backup codes for the 2FA plugin.
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

// ============================================================================
// ORGANIZATIONS — Multi-tenancy core
// ============================================================================
//
// Every domain entity in this app should hang off Organization via an
// `organizationId` foreign key. The protectedProcedure (see src/trpc/
// procedures/protected.ts) guarantees that the active organization is
// always present in ctx, so all queries can be safely scoped by tenant.
//
// SOURCE OF TRUTH KEYWORDS: Organization
// ============================================================================

/// Organization — a tenant. Owns all members, subscriptions, and domain data.
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  // Billing — Stripe customer for this tenant. Set on first checkout / when a
  // card is added, so a free org can store a payment method before subscribing.
  // The Subscription model also carries stripeCustomerId; this is the durable
  // org-level handle used by resolveExistingStripeCustomerId (payment.service).
  stripeCustomerId String?

  // Platform admin — when true, this org is the operator's "portal" workspace.
  // getOrganizationTier short-circuits it to the hidden, unlimited `portal`
  // tier, and its members get the /portal super-admin console. Bootstrapped
  // from PORTAL_INITIAL_OWNER_EMAIL (src/lib/config/portal.ts).
  isPortalOrganization Boolean @default(false)

  // Relations
  members           Member[]
  invitations       Invitation[]
  organizationroles OrganizationRole[]
  subscriptions     Subscription[]
  usageMetrics      UsageMetrics[]
  activityLogs      ActivityLog[]
  clipJobs          ClipJob[]
  clips             Clip[]
  clipEdits         ClipEdit[]

  @@map("organization")
}

/// Member — links a User to an Organization with a role (owner | admin | member
/// | <custom-role>). Custom roles are defined in OrganizationRole.
///
/// SOURCE OF TRUTH KEYWORD: Member
model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member")
}

/// Invitation — pending invite to join an organization. Becomes a Member on
/// accept; cancellation or expiration deletes the row (hard delete only, per
/// the project's no-soft-delete rule). The mere existence of a row implies
/// "pending"; status is encoded by presence rather than a column.
model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

/// OrganizationRole — custom roles created per-org. ONE row per (organization,
/// role); the `permission` column stores a JSON object map of the form
/// `{ "<resource>": ["<action>", ...] }` (e.g. `{"member":["read"],"projects":
/// ["read","create"]}`). The organizationRoles router writes it; the tRPC
/// context (src/trpc/init.ts) JSON-parses it and flattens to `resource:action`
/// strings to drive requirePermission checks. The static `owner` role is NOT
/// stored here — owners get a sentinel "all access" in the context resolver.
///
/// Use this together with the permission statement built in
/// src/lib/better-auth/permissions.ts.
///
/// SOURCE OF TRUTH KEYWORD: OrganizationRole
model OrganizationRole {
  id             String       @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organizationRole")
}

// ============================================================================
// BILLING — Subscription tier (drives feature gates)
// ============================================================================

/// Subscription — links an Organization to a Stripe subscription and plan tier.
/// The `plan` field MUST match a key in `PLANS` (src/lib/config/plans.ts) — e.g.
/// "free" | "starter" | "pro" | "enterprise". Resolving the org's tier reads
/// this row's plan when status is active/trialing.
///
/// SOURCE OF TRUTH KEYWORD: Subscription
model Subscription {
  id                   String       @id
  plan                 String       // Must match a key in `PLANS` (src/lib/config/plans.ts)
  referenceId          String       // Organization ID this subscription belongs to
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String       @default("incomplete") // incomplete|active|trialing|past_due|canceled
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

/// CardFingerprint — free-trial abuse prevention. Stores the Stripe card
/// `fingerprint` (a stable hash of the card, identical across re-tokenizations
/// and across customers) per user, with a `usedFreeTrial` flag. Before granting
/// a trial, billing checks whether this user OR any user has already used a
/// trial with the same card fingerprint. Tracking is best-effort and
/// non-critical: every read fails OPEN (allows the trial) so a Stripe/DB hiccup
/// never blocks a legitimate signup.
///
/// SOURCE OF TRUTH KEYWORD: CardFingerprint
model CardFingerprint {
  id            String   @id @default(cuid())
  userId        String
  fingerprint   String   // Stripe card fingerprint (pm.card.fingerprint)
  usedFreeTrial Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per (user, card); fingerprint indexed for the cross-user lookup.
  @@unique([userId, fingerprint])
  @@index([fingerprint])
  @@index([userId])
  @@map("cardFingerprint")
}

// ============================================================================
// REFERRAL TRACKING
// ============================================================================

/// ReferralCode — one shareable code per user (nanoid, uppercase). Created
/// lazily the first time the user opens the referrals page. Attribution only —
/// no money moves; see referral.service.ts for the future payout seam
/// (ReferralEarning credited from the webhook's invoice.payment_succeeded).
///
/// SOURCE OF TRUTH KEYWORD: ReferralCode
model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]

  @@map("referralCode")
}

/// ReferralAttribution — "user X was referred by code Y" (first-touch, written
/// once at signup from the ref_code cookie; org linked later at onboarding).
/// `referredUserId` is unique: a user can only ever be referred once.
///
/// SOURCE OF TRUTH KEYWORD: ReferralAttribution
model ReferralAttribution {
  id                     String   @id @default(cuid())
  referralCodeId         String
  referredUserId         String   @unique
  referredOrganizationId String?
  createdAt              DateTime @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@map("referralAttribution")
}

// ============================================================================
// FEATURE GATE USAGE TRACKING
// ============================================================================

/// UsageMetrics — current consumption of a "limit" resource for an org.
/// Writes happen via incrementUsage() / decrementUsage() in
/// src/services/usage.service.ts. Reads happen via getFeatureGates() in
/// src/lib/feature-gate.ts, which combines this with the plan config to
/// compute remaining quota.
///
/// One row per (organization, featureKey). The `featureKey` column stores the
/// BARE resource key from `RESOURCES` (src/lib/resources.ts) — e.g. `"projects"`,
/// `"storage"`, `"apiCalls"`. The column name is historical; semantically it is
/// a `LimitResourceKey`.
///
/// SOURCE OF TRUTH KEYWORD: UsageMetrics
model UsageMetrics {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String   // A LimitResourceKey from `RESOURCES` (src/lib/resources.ts)
  currentUsage   Int      @default(0)
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite uniqueness so each org has at most one row per featureKey
  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("usageMetrics")
}

// ============================================================================
// AUDIT LOG (forensic-grade)
// ============================================================================

/// ActivityLog — append-only audit trail. Written via logActivity() in
/// src/services/activity-log.service.ts inside the same transaction as the
/// handler mutation, so the audit row and the business data commit together
/// (or both roll back).
///
/// SECURITY: ipAddress and userAgent are forensic fields. They are written
/// by the server (via getRequestForensics) and MUST NEVER be returned to
/// any frontend endpoint. Reads from this table go through the
/// AUDIT_LOG_SAFE_SELECT pick which deliberately omits both fields.
///
/// SOURCE OF TRUTH KEYWORD: ActivityLog
model ActivityLog {
  id             String   @id @default(cuid())
  userId         String   // Actor — the user who performed the action
  organizationId String   // Tenant scope
  action         String   // "create" | "update" | "delete" | <custom verb>
  entity         String   // Entity type — e.g., "project", "member", "invitation"
  entityId       String?  // Affected entity ID (optional for org-level actions)
  description    String?  // Human-readable summary, e.g., "Renamed Project 'A' → 'B'"
  metadata       Json?    // Structured before/after diff or extra context
  ipAddress      String?  // FORENSIC ONLY — never exposed to frontend
  userAgent      String?  // FORENSIC ONLY — never exposed to frontend
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Indexes tuned for the most common queries: org timeline, user timeline,
  // and recent-activity dashboards. Add additional indexes only when a real
  // query proves they're needed.
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entity])
  @@map("activity_log")
}

// ============================================================================
// CLIPTIC — AI video clipping (domain models)
// ============================================================================
//
// A ClipJob is one long-running pipeline run (link/upload → audio → transcript
// → AI-selected ranges → cut clips), executed on the BullMQ worker, NOT in a
// request. Job state lives here (single source of truth) so the UI can poll
// progress and retries can resume from the last checkpoint. Every row is scoped
// by organizationId (tenancy) — see src/trpc/procedures/protected.ts.
//
// SOURCE OF TRUTH KEYWORDS: ClipJob, Clip, ClipJobStatus, ClipSourceType
// ============================================================================

/// Pipeline lifecycle. Advances QUEUED → DOWNLOADING → TRANSCRIBING →
/// ANALYZING → CUTTING → COMPLETED; any active state can go to FAILED; a
/// queued/active job can be CANCELED. The worker writes this after each stage.
enum ClipJobStatus {
  QUEUED
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  CUTTING
  COMPLETED
  FAILED
  CANCELED
}

/// Where the source video comes from. YOUTUBE = yt-dlp on `sourceUrl`;
/// UPLOAD = a user file already in R2 at `uploadKey`.
enum ClipSourceType {
  YOUTUBE
  UPLOAD
}

/// How a job's clips are chosen. AUTO = the LLM picks viral moments (default);
/// MANUAL = the user supplies exact ranges (worker skips the analyze stage).
enum ClipJobMode {
  AUTO
  MANUAL
}

/// Who chose a given clip's range. AI = the analyze LLM; MANUAL = the user's
/// exact timestamp pick. Lets one video hold both AI and hand-picked clips.
enum ClipSource {
  AI
  MANUAL
}

/// ClipJob — one clip-generation run for an organization.
///
/// SOURCE OF TRUTH KEYWORD: ClipJob
model ClipJob {
  id              String         @id @default(cuid())
  organizationId  String
  userId          String // actor who started the job
  status          ClipJobStatus  @default(QUEUED)
  mode            ClipJobMode    @default(AUTO) // AUTO (LLM) or MANUAL (user ranges)
  sourceType      ClipSourceType
  sourceUrl       String? // YOUTUBE: the pasted URL
  uploadKey       String? // UPLOAD: R2 key of the uploaded source file
  sourceKey       String? // persisted 720p source (R2) — reused by manual re-cuts
  manualRanges    Json? // pending user-picked ranges awaiting a manual cut — see ManualRange
  externalVideoId String? // yt-dlp video id, or a content hash for uploads
  title           String?
  durationSec     Float?
  progress        Int            @default(0) // 0–100, weighted rollup for the UI bar
  currentStage    String? // human label of the active stage
  clipCount       Int            @default(0)
  error           String? // user-safe failure message (never raw internals)
  llmProvider     String? // snapshot of provider used, for audit/repro
  transcriber     String?
  transcriptKey   String? // R2 key of the cached transcript (retry checkpoint)
  timings         Json? // per-stage wall-clock (ms) for perf measurement — see ClipJobTimings
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips        Clip[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([status])
  @@map("clip_job")
}

/// Clip — a single rendered short clip produced by a ClipJob. `organizationId`
/// is denormalized so tenant-scoped queries and signed-URL ownership checks
/// don't need to join through ClipJob.
///
/// SOURCE OF TRUTH KEYWORD: Clip
model Clip {
  id             String   @id @default(cuid())
  clipJobId      String
  organizationId String
  index          Int // 1-based order within the job
  source         ClipSource @default(AI) // AI-selected or a user MANUAL pick
  title          String?
  reason         String? // why the AI picked this moment (null for manual)
  score          Int? // 0–100 virality guess (optional)
  startSec       Float
  endSec         Float
  r2Key          String // R2 object key of the rendered mp4
  thumbnailKey   String? // R2 object key of the poster image
  sizeBytes      Int?
  durationSec    Float?
  createdAt      DateTime @default(now())

  clipJob      ClipJob      @relation(fields: [clipJobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  edit         ClipEdit?

  @@index([clipJobId])
  @@index([organizationId])
  @@map("clip")
}

/// How a clip's editor render is progressing. DRAFT = spec saved but not yet
/// rendered; QUEUED → RENDERING → COMPLETED; any active state can go FAILED; a
/// queued/rendering edit can be CANCELED. The clip-render worker writes this
/// after each step (mirrors the ClipJobStatus pattern, but scoped to a render).
enum ClipEditStatus {
  DRAFT
  QUEUED
  RENDERING
  COMPLETED
  FAILED
  CANCELED
}

/// ClipEdit — a NON-DESTRUCTIVE edit of a single Clip. Holds the validated edit
/// spec (the JSON recipe the browser Editor builds — see src/lib/types/edit-spec.ts)
/// plus the status + output keys of the server-side render that applies it. The
/// original Clip is never mutated; the edited output is a separate R2 object.
///
/// One live edit per clip in v1 (`@@unique([clipId])`) — relax to a version list
/// later by dropping the unique + adding a label/version. `organizationId` is
/// denormalized (like Clip) so tenant-scoped queries and signed-URL ownership
/// checks never have to join Clip → ClipJob.
///
/// SOURCE OF TRUTH KEYWORD: ClipEdit
model ClipEdit {
  id                 String         @id @default(cuid())
  clipId             String
  organizationId     String
  spec               Json // validated EditSpec — see src/lib/types/edit-spec.ts
  status             ClipEditStatus @default(DRAFT)
  progress           Int            @default(0) // 0–100 for the render bar
  currentStage       String? // human label of the active render step
  error              String? // user-safe failure message (never raw internals)
  aspect             String? // snapshot of spec.reframe.aspect for listings
  outputR2Key        String? // R2 key of the rendered edited mp4
  outputThumbnailKey String? // R2 key of the edited poster image
  outputSizeBytes    Int?
  outputDurationSec  Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?

  clip         Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([clipId])
  @@index([organizationId])
  @@map("clip_edit")
}
